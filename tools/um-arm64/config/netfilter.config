# netd gate (A14, the 8th Android-vs-vanilla gap): netd exits status 1 at
# startup when its kernel faces are missing -- "Operation not supported,
# probably kernel is missing an important feature". It needs nftables (+address
# families), xtables/legacy iptables, conntrack, and cgroup skb egress-proc.
# netd's onrestart chain then SIGKILLs zygote: the crash-loop we saw was netd,
# not zygote. UML defconfig has NO CONFIG_NETFILTER at all; upstream's
# docker.config proves this exact stack compiles+links on this bionic tree.
# Subset of docker.config net bits, trimmed to netd's requirements.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
# netd "missed eBPF usage" = cgroup skb attach; BPF_SYSCALL/CGROUP_BPF already
# in redroid.config (bpfloader gate), NF_TARGETS lets netd use nft+ebpf hooks.
CONFIG_NETFILTER_EBPF=y
# DNS/resolve paths netd exercises over AF_INET sockets; harmless if already on
# via defconfig.
CONFIG_IPV6=y
