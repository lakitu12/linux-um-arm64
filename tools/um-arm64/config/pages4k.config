# 4 KB guest pages -- required for Android guests built against 4K assumptions.
#
# redroid images (May-2024 era) ship dynamic loaders with 4K-aligned arenas;
# a 16K-page guest kernel misplaces linker64's own anonymous regions and it
# dies inside its first demangler-adjacent init path (observed on dash:
# SIGSEGV in linker64, fault = mapping_end + 0x32c24). Alpine/static guests
# don't care, which is why the same kernel passed g2/g3 before failing on
# redroid.
#
# Legal because dash's HOST is 4 KB pages (getconf PAGESIZE = 4096): guest
# page size may be >= host, and 4 == 4. The upstream build-android.sh does
# exactly this toggle for its linux-android-4k artifacts.
#
# merge_config semantics: "# CONFIG_X is not set" is the disable line.
# CONFIG_PAGE_SIZE_16KB is not set
CONFIG_PAGE_SIZE_4KB=y
