# Guest kernel config for Android (redroid) guests under UML arm64.
#
# Apply on top of defconfig via EXTRA_CONFIG (build-bionic.sh merges these with
# merge_config.sh before olddefconfig, so `select`ed dependencies land too).
#
# Why a fragment instead of kernel-side defaults: this is OUR workload, not the
# port's. Upstream has no ANDROID_BINDER* symbols anywhere in its configs; on
# 7.2-rc4 with a Debian rootfs it never needs them.

# The one requirement Android cannot boot without. depends on MMU && NET, both
# satisfied on UML (arch/um selects MMU; NET is default). binderfs gives us a
# per-guest /dev/binder without the old global device node, which matters when
# two VMs run on one host kernel.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Android 11+ FUSE-based sdcardfs replacement: init starts
# /system/bin/sdcard as a FUSE daemon; without FUSE_FS the storage daemon
# fails and storage-dependent apps die at first use, not at boot.
CONFIG_FUSE_FS=y

# bpfloader (boot-critical since Android 12) opens
# /proc/sys/kernel/unprivileged_bpf_disabled and reboots with
# 'bpfloader-failed' when the node is absent — the node is #ifdef
# CONFIG_BPF_SYSCALL in kernel/bpf/syscall.c, and UML's defconfig only has
# plain CONFIG_BPF (from networking). CGROUP_BPF joins because bpfloader
# loads cg-attached programs (cgroup_getprog etc.) and netd will want them;
# upstream's docker fragment notes BPF compiles against bionic on this tree.
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Android init mounts /dev as devtmpfs to get its console/hw randomness.
# The UML defconfig has DEVTMPFS (the umarm-init mounts it), restate so the
# fragment is self-contained when diffed against a future defconfig.
CONFIG_DEVTMPFS=y

# prng_seeder (Android 12+) hangs forever without /dev/hw_random and forces a
# reboot->init->reboot loop; observed at the 9th line of second-stage on the
# first app-mode redroid boot. UML implements hw_random as an hwrng client
# (arch/um/drivers/random.c reads the HOST /dev/random via os_read_file — it
# needs no host device node itself), so the fix is purely the core driver:
# HW_RANDOM defaults to m and UML has no module support, so it silently
# drops out of olddefconfig; =y misc-registers /dev/hw_random (major 10,
# minor RNG_MISC_MINOR) which ueventd's rule already knows how to chown.
# Symbols verified against the tree: drivers/char/hw_random/Kconfig:641
# defines UML_RANDOM (depends on UML, select HW_RANDOM). Restating the
# select explicitly is harmless and survives an olddefconfig re-evaluation.
CONFIG_HW_RANDOM=y
CONFIG_UML_RANDOM=y

# Android init mounts /sys/fs/selinux first-stage; on a permissive-by-design
# VM the mount failing EINVAL is init's own fallback (we keep enforcing off in
# the guest: no sepolicy image is loaded), but the mknod(EINVAL) for /dev/ptmx
# comes from devtmpfs already holding the node — benign, init continues.

# ashmem: NOT here on purpose. Linux removed the staging ashmem driver
# (drivers/staging/android) years before 7.2, and redroid's own docs say the
# guest is happy with "ashmem / memfd" -- Android 11+ userspace falls back to
# memfd (this is exactly what proot's ashmem_memfd extension translates
# ioctl-for-ioctl). M2 gate on the device will confirm: if init or surface
# flinger opens /dev/ashmem and dies, the fix is the guest-side property
# ro.dalvik.vm.use_memfd=true, not a kernel driver resurrected out of 6.6.

# lmkd gate (A14, the fifth Android-vs-vanilla gap): lmkd is boot-critical and
# exits at startup -- "Kernel does not support memory pressure events or
# in-kernel low memory killer" -- when BOTH of its pressure sources are absent:
#   PSI      -> /proc/pressure/memory is gated by CONFIG_PSI (ktest3 .config:
#               "# CONFIG_PSI is not set"; UML defconfig has no PSI)
#   memcg v1 -> memory.pressure_level / cgroup.event_control gated by
#               CONFIG_MEMCG (init also logs "cgroup: Unknown subsys name
#               'memory'" without it)
lmkd strings on the real image confirm both branches. PSI=y alone is enough for
the modern path (psi=1 by default unless CONFIG_PSI_DEFAULT_DISABLED); MEMCG=y
also covers the v1 fallback and the init mount, and upstream's docker.config
already proves it compiles on this tree.
CONFIG_PSI=y
CONFIG_MEMCG=y

# ext4 with SELinux xattrs is the rootfs format; hostfs is used for the share
# dir. Both already in defconfig; nothing needed here.

# vold gate (A14, the 12th Android-vs-vanilla gap, m19 2026-10-02): UserDataPreparer
# -> StorageManagerService.prepareUserStorage -> vold fscrypt_prepare_user_storage
# sets a POSIX default ACL on /data/media/0. Without FS_POSIX_ACL the ext4
# superblock rejects it: 'Failed to set default ACL on /data/media/0: Operation
# not supported on transport endpoint' (EOPNOTSUPP), the exception aborts user-data
# prep, /data/user_de/0/* is never created, and the next tick com.android.phone
# (persistent) dies on 'HbpcdLookupProvider: Directory .../databases doesn't
# exist' -> AMS kills zygote in a loop ~4 min after boot_completed. That is the
# real cause of the 'boot then crash cascade' (NOT the app-level trigger we
# first suspected); m16-m18 never lived long enough to see it fire.
# UML arm64_defconfig has CONFIG_EXT4_FS=y but NO EXT4_FS_POSIX_ACL (only
# TMPFS_POSIX_ACL). EXT4_FS_POSIX_ACL depends only on EXT4_FS and selects
# FS_POSIX_ACL -- no EXPERT gate, no other option change.
CONFIG_EXT4_FS_POSIX_ACL=y
