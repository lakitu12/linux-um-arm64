# M2-boot multi-core gate (m19 era, 2026-10-02).
#
# Why: measured on marble — the UML console process showed exactly ONE guest
# CPU thread running (host `top -H` on the libuml pid: 1 R + 2 S, idle
# everywhere else). Android's boot cascade (AMS/system_server/zygote fork
# storms, and the post-boot bt/phone crash loops) is parallel-friendly; a
# 1-vCPU guest serializes all of it behind a single core and the whole VM
# crawls even with a 12-thread host idling at 639% free.
#
# UML specifics on this tree:
#   - NR_CPUS is a compile-time ceiling only; the runtime count comes from the
#     ncpus= boot argument, which upstream's smp.c defaults to
#     clamp(host_cpus - 1, 1, NR_CPUS) when unset.
#   - The SECCOMP userspace mode (the app's seccomp=auto, proven working since
#     M1-app) supports SMP; the PTRACE fallback hard-clamps to 1 with a message
#     (start_up.c), so one binary scales per host and never fails to boot.
#   - Upstream already ships tools/um-arm64/config/smp.config; we restate it
#     here so the CI default EXTRA_CONFIG (which lists only this repo's config/
#     fragments) actually carries it — a fragment nobody merges is the exact
#     drift class the CI assertions exist to catch.
CONFIG_SMP=y
CONFIG_NR_CPUS=16
