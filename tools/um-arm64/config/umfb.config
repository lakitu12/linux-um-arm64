# UML display: a framebuffer whose changed tiles are mirrored into a
# host file or memfd, where viewers pick them up (tools/um-arm64/umview
# on Linux; the console app on Android).  It activates with
#   umlfb=<path|fd:N>:<W>x<H>[-32][,hz=N][,tile=N]
# on the guest kernel command line and stays dormant without it.
#
# FB (the driver framework) sits behind HAS_IOMEM, which UML turns off
# by default: UML_IOMEM_EMULATION opens that gate -- the same one the
# fb-vfb fragment carries, so a build that has either fragment can see
# the fbdev menu.  (Keep both if video=vfb: is also in use.)
CONFIG_UML_IOMEM_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_UML_FB=y
